# ===== Configuration du serveur MCP Excel-to-Indicator =====

# Répertoires de données
MCP_EXCEL_SOURCES_DIR=./data/actual/excel_sources
MCP_MAPPING_DIR=./data/actual/mappings
MCP_MAPPING_FILE=./data/actual/mappings/mapping.json

# Logging
MCP_LOG_LEVEL=INFO
MCP_LOG_FILE=./logs/mcp.log

# Résolution des formules
MCP_MAX_DEPTH_RESOLUTION=5
MCP_CACHE_ENABLED=true

# Serveur MCP (optionnel pour testing)
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000

# Mode debug
DEBUG=false
